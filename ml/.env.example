# kcr-backend address (dev: http://localhost:8080)
KCR_BACKEND_BASE_URL=http://localhost:8080

# Same secret as kcr-backend jwt.secret (HS256), environment only
AUTH_JWT_SECRET=change-me

# LLM: api (cloud provider, testing) | local (Qwen via vLLM/Ollama, production)
LLM_PROVIDER=api
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=qwen

# Optional limits (defaults shown)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=2048
# AI_CHAT_HISTORY_LIMIT=20
# AI_MAX_TOOL_ITERATIONS=5
# AI_MAX_TABLE_ROWS=50
# AI_MAX_SCAN_CLIENTS=500

# Prioritization scoring weights (defaults shown)
# AI_SCORE_UNTRANSFERRED=40
# AI_SCORE_DYNAMICS=25
# AI_SCORE_URGENCY=20
# AI_SCORE_STAGE=10
# AI_SCORE_VIP=5

# Frontend origins, comma-separated
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
