# kcr-backend address (dev: http://localhost:8080)
KCR_BACKEND_BASE_URL=http://localhost:8080

# Internal service token kcr-backend presents on every call (same value as ML_INTERNAL_TOKEN
# of kcr-backend); minimum 32 bytes, environment only
AUTH_INTERNAL_TOKEN=change-me-32-bytes-minimum

# LLM: api (cloud OpenAI-compatible provider, testing) | local (Qwen via vLLM/Ollama, production)
LLM_PROVIDER=api
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
# local: LLM_PROVIDER=local, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen... (no key needed)

# Optional limits (defaults shown)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=2048
# AI_CHAT_HISTORY_LIMIT=20
# AI_MAX_TOOL_ITERATIONS=5
# AI_MAX_TABLE_ROWS=50
# AI_MAX_SCAN_CLIENTS=500

# Prioritization scoring weights (defaults shown)
# AI_SCORE_UNTRANSFERRED=40
# AI_SCORE_DYNAMICS=25
# AI_SCORE_URGENCY=20
# AI_SCORE_STAGE=10
# AI_SCORE_VIP=5
