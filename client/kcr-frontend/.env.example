# Базовый URL API для dev-сервера (npm run dev), без завершающего слэша.
# Значение запекается в сборку: после правки перезапустить dev-сервер / пересобрать.
# Бэкенд должен разрешать origin http://localhost:5173 (CORS на :8080).

# REST API бэкенда (kcr-backend); ИИ-запросы (/api/v1/ai/**) идут через тот же URL —
# бэкенд сам проксирует их в kcr-ml
VITE_API_BASE_URL=http://localhost:8080/api/v1

# В образе контейнерного стенда задаются относительные адреса (проксирует nginx):
# VITE_API_BASE_URL=/api/v1
