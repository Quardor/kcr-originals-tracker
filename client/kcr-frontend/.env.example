# Базовые URL API для dev-сервера (npm run dev), без завершающего слэша.
# Значения запекаются в сборку: после правки перезапустить dev-сервер / пересобрать.
# Бэкенд и kcr-ml должны разрешать origin http://localhost:5173 (APP_CORS_ALLOWED_ORIGINS).

# REST API бэкенда (kcr-backend)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# API ИИ-помощника (kcr-ml); WebSocket чата строится из этого адреса
VITE_AI_BASE_URL=http://localhost:8000/api/v1/ai

# В образе контейнерного стенда задаются относительные адреса (проксирует nginx):
# VITE_API_BASE_URL=/api/v1
# VITE_AI_BASE_URL=/api/v1/ai
