# Локальные dev-секреты. Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
# .env не коммитится (.gitignore) и читается только профилем dev
# (spring.config.import в application-dev.yaml). Переменные окружения
# приоритетнее значений из .env.

# Пароль локального PostgreSQL.
DB_PASSWORD=

# HMAC-ключ для подписи JWT, минимум 32 байта.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Необязательно: пользователь БД (по умолчанию myuser).
# DB_USERNAME=myuser

# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# --- docker-compose (docker-compose.yml подставляет эти значения) ---

# Учётка первого ADMIN (создаётся только на пустой базе).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Разрешённые CORS-источники, через запятую.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
