# Локальные dev-секреты. Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
# .env не коммитится (.gitignore) и читается только профилем dev
# (spring.config.import в application-dev.yaml). Переменные окружения
# приоритетнее значений из .env.
# Для контейнерного стенда те же переменные задаются в корневом .env монорепо
# (шаблон — .env.example в корне репозитория), этот файл — только для bootRun и тестов.

# Пароль PostgreSQL стенда (контейнер kcr-db-1, база и пользователь kcr, порт 5433).
DB_PASSWORD=

# HMAC-ключ для подписи JWT, минимум 32 байта — иначе приложение не стартует.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Токен для вызовов kcr-ml (тот же, что AUTH_INTERNAL_TOKEN у kcr-ml), минимум 32 байта — иначе
# приложение не стартует; ML_BASE_URL нужен только в проде. Сгенерировать: openssl rand -hex 32
ML_INTERNAL_TOKEN=

# Необязательно: пользователь БД (по умолчанию kcr).
# DB_USERNAME=kcr

# Первый администратор: создаётся при старте, если в базе нет ни одного пользователя
# с ролью ADMIN (в dev без этих значений приложение стартует с предупреждением).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Разрешённые CORS-источники, через запятую (в dev задано в application-dev.yaml).
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
