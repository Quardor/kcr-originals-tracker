# Шаблон окружения единого стенда: скопируйте в .env и заполните.
# docker compose up -d --build   (из корня монорепозитория)

# --- PostgreSQL / kcr-backend ---
DB_PASSWORD=change-me
# Общий секрет HS256 для kcr-backend и kcr-ml (проверка access-токенов)
JWT_SECRET=change-me-32-bytes-minimum
# Первый админ создаётся при старте, если таблица пользователей пуста
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- kcr-ml (LLM) ---
# api = облачный OpenAI-совместимый провайдер (этап тестов)
# local = локальный Qwen: docker compose --profile local up -d ollama,
#        LLM_BASE_URL=http://ollama:11434/v1, ключ не нужен
LLM_PROVIDER=api
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-5.4-mini
# Адрес бэкенда из контейнера ml; по умолчанию http://app:8080 (сеть compose).
# Меняйте, только если бэкенд живёт вне стенда, например http://host.docker.internal:8080
# KCR_BACKEND_BASE_URL=http://app:8080
