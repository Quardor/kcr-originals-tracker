# Шаблон окружения единого стенда: скопируйте в .env и заполните.
#   cp .env.example .env
# docker compose up -d --build   (из корня монорепозитория)
# .env в git не попадает.

# --- PostgreSQL / kcr-backend ---
DB_PASSWORD=change-me
# Общий секрет HS256 для kcr-backend и kcr-ml (проверка access-токенов).
# Минимум 32 байта — с шаблонным значением бэкенд не стартует. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-minimum
# Первый ADMIN создаётся при старте, только если в базе нет ни одного пользователя
# с ролью ADMIN. Смена ADMIN_PASSWORD потом пароль существующего аккаунта не меняет.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Разрешённые CORS-источники, через запятую. Нужен только при прямом обращении браузера
# к :8080/:8000 (например, dev-сервер Vite); через frontend-прокси CORS не участвует.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- kcr-ml (LLM) ---
# api = облачный OpenAI-совместимый провайдер (этап тестов)
# local = локальный Qwen: docker compose --profile local up -d ollama,
#        LLM_BASE_URL=http://ollama:11434/v1, ключ не нужен
LLM_PROVIDER=api
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-5.4-mini
# Адрес бэкенда из контейнера ml; по умолчанию http://app:8080 (сеть compose).
# Меняйте, только если бэкенд живёт вне стенда, например http://host.docker.internal:8080
# KCR_BACKEND_BASE_URL=http://app:8080
# Необязательные лимиты, веса скоринга и таймауты kcr-ml — таблица §13 ml/ARCHITECTURE.md.
